{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchestrator Tool",
  "mainBinaryName": "Orchestrator Tool",
  "version": "0.1.0",
  "identifier": "io.github.tom758258.orchestrator-tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orchestrator Tool",
        "create": false,
        "width": 1920,
        "height": 1080,
        "center": true,
        "preventOverflow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    },
    "icon": [
      "icons/orchestrator-icon.png",
      "icons/orchestrator-icon.ico"
    ]
  }
}